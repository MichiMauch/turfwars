TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token
# Required — the server refuses to start without it, since the audience of
# incoming Google ID tokens is checked against this value.
GOOGLE_CLIENT_ID=239062108739-l2s28bkfqga6so33lvdc9pa4ditbdmvf.apps.googleusercontent.com
PORT=3005

# Accounts allowed to use /territories/dev/* (comma-separated emails or
# Google account IDs). Leave empty to disable the dev endpoints entirely.
DEV_ADMIN_ACCOUNTS=
